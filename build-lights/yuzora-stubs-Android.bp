// Stub — see the "Prune unneeded subtrees + stub missing
// defaults" step in
// .github/workflows/build-lights-hal.yml (run #36 fix).
// Verbatim replica of the "apex-lowest-min-sdk-version"
// definition from packages/modules/common/sdk/Android.bp
// (LineageOS android_packages_modules_common, lineage-22.2,
// lines 575-601; APEX_LOWEST_MIN_SDK_VERSION = "30", line 333).
// The real project is NOT synced: its java/ + javatests/
// concrete modules reference unsynced framework libs, so syncing
// it would trade one undefined module for more. This stub gives
// system/core/libutils (the only user in this tree) exactly what
// the real definition gives it: min_sdk_version "30" by default.
soong_config_module_type_import {
    from: "system/apex/Android.bp",
    module_types: [
        "library_linking_strategy_cc_defaults",
    ],
}

library_linking_strategy_cc_defaults {
    name: "apex-lowest-min-sdk-version",
    defaults_visibility: [
        "//system/core/libutils:__subpackages__",
    ],
    min_sdk_version: "30",
    soong_config_variables: {
        library_linking_strategy: {
            prefer_static: {
                min_sdk_version: "apex_inherit",
            },
        },
    },
}

// use_libaidlvintf_gtest_helper_static (runs #38/#39 fix):
// empty cc_defaults stub for the VTS-test helper defined in
// system/libvintf/libaidlvintf_test_helper/Android.bp (AOSP r32,
// unsynced — its static_libs chain needs libz + libselinux).
// Referenced by VTS target tests across hardware/interfaces and
// hardware/google/interfaces (bluetooth + automotive/ivn in runs
// #36/#38/#39). VTS tests are never built for this HAL-only
// target, so only the NAME has to exist for Soong's parse.
cc_defaults {
    name: "use_libaidlvintf_gtest_helper_static",
    // Public on purpose: VTS tests referencing this helper live
    // all over hardware/interfaces + hardware/google/interfaces,
    // and more may surface on later runs — a restricted list
    // would turn an unknown user into a visibility error.
    defaults_visibility: [
        "//visibility:public",
    ],
}


  name: "core-all-system-modules",
  libs: ["core-lambda-stubs-for-system-modules"],
  visibility: [
    "//visibility:public",
  ],
}

// Runs #75/#76/#77 fix: "libwinpthread", the implicit Windows-host dep of
// frameworks/native/libs/math libmath_headers (no such property in the file at
// lineage-22.2 — Soong adds it for windows-enabled cc modules; HOST_CROSS_OS=windows).
// Linked statically, so this stub is an (empty) cc_library_static with the dummy source
// empty.c — same form as the hintmanager/skia stubs. The defining project is unsynced
// and libmath_headers is never built here, so the empty lib never links into anything.
// Runs #144/#145/#146 fix: the #141/#142/#143 fix HELD in
// all three (prune step passed + pre-build guard passed,
// zero "depends on undefined module" / "missing variant"
// lines in any raw log - the 9 new stubs all resolved).
// All three fail at Soong ninja-file generation, 36-51s
// into the build step, on the SAME fix code (head add4635
// - the #141/#142/#143 fix, workflow e5946a7; #144 is the
// manifest push 12f612a, #145 the README push add4635 -
// same workflow file in all three, #146 a manual dispatch
// ~05:45 IST on add4635). NEW failure class, not an
// undefined module: a Soong dependency cycle, raw-log
// verbatim from #146 (job-logs.txt, Build step lines
// 476-478; log-search verified 0 matches for "depends on
// undefined module", "missing variant" and "undefined"):
//   error: prebuilts/clang/host/linux-x86/Android.bp:444:1:
//     encountered dependency cycle:
//   error: yuzora-stubs/Android.bp:620:1: module
//     "libwinpthread" variant "windows_x86_static" depends
//     on module "libc++_static" variant "windows_x86_static"
//   error: prebuilts/clang/host/linux-x86/Android.bp:444:1:
//     module "libc++_static" variant "windows_x86_static"
//     depends on module "libwinpthread" variant
//     "windows_x86_static"
// FAILED line is out/soong/build.yuzora_lights.ninja.
// Root cause, verified in the SYNCED Soong source
// (build/soong/cc): (1) this stub has no `stl:` property,
// so it takes Soong's default STL - stl.go says a blank
// stl selects "libc++_static" (case "libc++",
// "libc++_static", "" -> "libc++_static", and stl.deps
// adds it as a dep) - so the stub depends on the real
// libc++_static (llvm_prebuilt_library_static,
// prebuilts/clang/host/linux-x86/Android.bp:444, the
// windows variant, since this stub is windows-enabled).
// (2) The real libc++_static depends back on this stub:
// linker.go:441-442 appends "libwinpthread" to
// LateStaticLibs for EVERY windows-variant cc module
// except libwinpthread itself. The two edges close a
// cycle. It surfaced only now because Soong's cycle
// check runs once all modules resolve - every earlier
// run died on undefined-module errors first (same
// one-layer-deeper pattern as #30/#33/#75/#102). Fix:
// `stl: "none"` on this stub (the empty.c stub needs no
// STL; the real libc++_static block itself carries
// `stl: "none"`). The reverse edge stays, one-way, so
// the cycle is broken. The stub stays cc_library_static
// with windows enabled - the #78/#79/#80 missing-variant
// errors (os:windows,link:static) still need exactly
// that. A second cycle behind this one, if any, will
// surface on the next run the same way.
cc_library_static {
  name: "libwinpthread",
  srcs: ["empty.c"],
  stl: "none",
  host_supported: true,
  target: { windows: { enabled: true } },
  visibility: [
    "//visibility:public",
  ],
}

// Runs #75/#76/#77 fix: "libconscrypt_openjdk_jni", referenced via `jni_libs:` by
// signapk (build/make/tools/signapk). Upstream it is the shared JNI library of
// external/conscrypt (unsynced), so this stub is an (empty) cc_library_shared with the
// dummy source empty.c — NOT a cc_library_static and NOT a java_library. signapk is
// never built here, so the empty .so never links into anything.
cc_library_shared {
  name: "libconscrypt_openjdk_jni",

<?xml version="1.0" encoding="UTF-8"?>

<!--
  Minimal repo manifest: build ONLY android.hardware.light-service.samsung
  (the forked Samsung lights HAL, with the no-op NOTIFICATIONS light for m51).

  Purpose: the full LineageOS sync (about 100 GB) does not fit a GitHub
  Actions runner (about 14 GB usable disk). This manifest syncs ONLY the
  dependency closure of the one module, traced file by file from the real
  .bp files (see build-lights/README.md for the closure reasoning and the
  pin table).

  Usage (in the workflow, or locally):
    repo init -u https://github.com/kkisdevil/android_hardware_samsung
              -b lineage-22.2 -m build-lights/manifest.xml
              (depth 1, no tags, current branch only, no repo verification)

    repo sync (current branch, jobs = nproc, no tags, force sync)

  All projects are shallow (clone-depth 1, no tags). LineageOS repos are
  pinned to branch refs/heads/lineage-22.2; AOSP repos to tag
  refs/tags/android-15.0.0_r32 (the Android 15 release LineageOS 22.2 is
  based on; verified: LineageOS 22.2 soong expects clang-r536225, which is
  exactly what the r32 prebuilts/clang tag provides). The HEAD SHA at the
  time each pin was verified is recorded in a comment above the project,
  so a future mismatch can be caught by comparing git rev-parse HEAD.

  The manifest repo itself (kkisdevil/android_hardware_samsung) is the
  fork: hardware/samsung is pinned to its lineage-22.2 branch, whose tip
  is the no-op-light commit e7968ab68b15d9bda03c267195c2bfb0af986874.
  It is NOT upstream LineageOS. Do not point hardware/samsung at upstream.
-->

<manifest>

  <remote name="github" fetch="https://github.com/" review="https://github.com/" />
  <remote name="aosp" fetch="https://android.googlesource.com/" />

  <default revision="refs/heads/lineage-22.2" remote="github" sync-j="4" />

  <!-- Build system -->

  <!-- build/make: envsetup.sh, lunch, m, core/config.mk (defines
       soong_config_set, used by the device BoardConfig.mk).
       Verified HEAD (lineage-22.2): ab5acb1281035ebc9b0f190baf22ef3ea896106e -->

  <project path="build/make" name="LineageOS/android_build" clone-depth="1">
    <!-- Linkfiles copied verbatim from LineageOS default.xml: repo sync
         creates build/envsetup.sh (plus build/core, build/target,
         build/tools, build/CleanSpec.mk, build/buildspec.mk.default)
         as links into build/make. Without them the synced tree has no
         build/envsetup.sh at all, and the workflow's build step dies
         before compiling anything — run #2 (45451816231) failed on
         exactly that: "build/envsetup.sh: No such file or directory". -->
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <!-- build/soong: Soong build engine; expects clang-r536225.
       Verified HEAD (lineage-22.2): 7330e4ab3b8ec184ceff16a9537c2fe093ff3626 -->

  <project path="build/soong" name="LineageOS/android_build_soong" clone-depth="1" />

  <!-- build/blueprint: Soong's build-graph library.
       Verified HEAD (lineage-22.2): c7c63940d4be6a08a01a30ababca3abc0d1ac3da -->

  <project path="build/blueprint" name="LineageOS/android_build_blueprint" clone-depth="1" />

  <!-- build/release: release configs (release_config_map + trunk_staging,
       ap2a, ...). REQUIRED. build/make/core/release_config.mk reads
       build/release/release_config_map.mk; without this project the map
       list is empty, ALL_RELEASE_CONFIGS_FOR_PRODUCT is empty, and lunch
       dies on the final product-config pass with "No release config found
       for TARGET_RELEASE: trunk_staging". Run #6 would have died on
       exactly that right after the lunch-combo fix — the combo fix alone
       is not enough. 34 MB, depth 1.
       Verified HEAD (lineage-22.2): 5ae4f77404fe7e7bc251661d22af85dc229f80bd -->

  <project path="build/release" name="LineageOS/android_build_release" clone-depth="1" />

  <!-- prebuilts/build-tools: ninja, bison, flex, etc. (host tools Soong calls).
       AOSP tag android-15.0.0_r32. -->

  <project path="prebuilts/build-tools" name="platform/prebuilts/build-tools" remote="aosp" revision="refs/tags/android-15.0.0_r32" clone-depth="1" />

